#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, r32ui)
uniform readonly uimage2D world_input;

layout(set = 0, binding = 1, r32ui)
uniform writeonly uimage2D world_output;

layout(set = 0, binding = 2, rgba8)
uniform writeonly image2D frame_output;

layout(push_constant) uniform PushConstants {
    int width;
    int height;
    uint seed;
} pc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    if (pixel.x >= pc.width || pixel.y >= pc.height)
        return;

    uint cell = imageLoad(world_input, pixel).r;

    vec3 color;

    if (cell == 0u) {
        color = vec3(0.80, 0.788, 0.471);
    } else {
        color = vec3(0.0, 0.647, 0.878);
    }

    imageStore(frame_output, pixel, vec4(color, 1.0));
}

